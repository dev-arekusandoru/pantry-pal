{
  "name": "pantrypal",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Self-hosted household pantry, recipe, meal-plan and shopping backend with REST API and MCP server.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pantrypal": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm build:server && pnpm web:build",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @pantrypal/web typecheck",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "build:server": "tsc -p tsconfig.build.json",
    "test:web": "pnpm --filter @pantrypal/web test",
    "test:all": "vitest run && pnpm test:web",
    "openapi": "tsx scripts/openapi.ts && pnpm --filter @pantrypal/web openapi:types",
    "web:dev": "pnpm --filter @pantrypal/web dev",
    "web:build": "pnpm --filter @pantrypal/web build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

---
import Layout from "../layouts/Layout.astro";
import Pal from "../components/Pal.astro";
import { site } from "../config";
---

<Layout title={`Page not found | ${site.name}`}>
  <main class="wrap lost">
    <Pal size={120} />
    <h1>That page isn't on the menu.</h1>
    <p>Let's get you back to the kitchen.</p>
    <a class="btn primary" href="/">Back to {site.name}</a>
  </main>
</Layout>

<style is:global>
  .lost { min-height: 100vh; display: grid; place-content: center; justify-items: center; gap: 14px; text-align: center; }
  .lost h1 { font-size: clamp(32px, 5vw, 48px); }
  .lost p { font-size: 19px; }
</style>

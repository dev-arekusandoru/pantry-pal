---
import { faq } from "../data/faq";
---

<section id="faq">
  <div class="head">
    <h2><span class="wavy">Good questions</span></h2>
    <p>Short answers to the things people ask first.</p>
  </div>

  <div class="faq">
    {faq.map((item, index) => (
      <details open={index === 0}>
        <summary>{item.q}</summary>
        <div class="a"><p>{item.a}</p></div>
      </details>
    ))}
  </div>
</section>

<style is:global>
  .faq { max-width: 820px; display: grid; gap: 14px; }
  .faq details { background: var(--card) var(--grain); border-radius: var(--r-lg); box-shadow: 0 0 0 var(--btn-w) var(--bd), 0 5px 0 var(--btn-w) color-mix(in srgb, var(--bd) 45%, transparent); transition: background-color var(--dur-fast); }
  .faq details[open] { background-color: var(--butter-s); }
  .faq summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 20px; font-family: var(--font-head); font-weight: 500; font-size: 22px; line-height: 1.25; border-radius: var(--r-lg); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--ink); color: var(--on-accent); font-family: var(--font); font-weight: var(--fw-bold); font-size: 22px; line-height: 1; padding-bottom: 2px; transition: transform var(--dur-fast) var(--ease); }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq .a { padding: 0 20px 18px; max-width: 62ch; font-size: 18px; }
</style>

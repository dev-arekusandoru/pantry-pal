---
import { compareCheckedOn, products, rows, type Cell } from "../data/compare";

const lines = (value: string) => value.split("\n");
const cellClass = (cell: Cell, us: boolean) =>
  [us && "us", cell.kind === "no" && "no", cell.kind === "text" && !us && "tx"]
    .filter(Boolean)
    .join(" ");
---

<section id="compare">
  <div class="head">
    <h2><span class="wavy">How we stack up</span></h2>
    <p>Plan to Eat, Paprika and Mealie are good apps, and we like them. Here's how PantryPal compares today.</p>
  </div>

  <div class="cmp-card paper">
    <div class="cmp-scroll" role="region" aria-label={`Comparison of ${products.join(", ")}`} tabindex="0">
      <table class="cmp">
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Feature</span></th>
            {products.map((name, index) => <th scope="col" class={index === 0 ? "us" : undefined}>{name}</th>)}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row">
                {row.label}
                {row.hint && <small>{row.hint}</small>}
              </th>
              {row.cells.map((cell, index) => (
                <td class={cellClass(cell, index === 0) || undefined}>
                  {cell.kind === "yes" && (
                    <svg role="img" aria-label="Yes"><use href="#i-tick"></use></svg>
                  )}
                  {cell.kind === "no" && (
                    <>
                      <span aria-hidden="true">&mdash;</span><span class="sr-only">Not found</span>
                    </>
                  )}
                  {cell.kind === "text" &&
                    lines(cell.text).map((line, i) => (i === 0 ? line : <><br />{line}</>))}
                  {cell.kind === "soon" && (
                    <>
                      <span class="soon">Not yet</span>
                      {cell.note && <small>{cell.note}</small>}
                    </>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <p class="note cmp-hint">Swipe the table sideways to see everyone &rarr;</p>
  <p class="note cmp-note">
    &ldquo;Not yet&rdquo; means it's on our list. A dash means we didn't find it on their site or docs. Facts and prices as of {compareCheckedOn}.
  </p>
</section>

<style is:global>
  .cmp-card { padding: 10px; }
  .cmp-scroll { overflow-x: auto; padding: 4px; }
  .cmp-scroll:focus-visible { outline-offset: 0; }
  .cmp { width: 100%; min-width: 780px; border-collapse: separate; border-spacing: 0; text-align: center; }
  .cmp th, .cmp td { padding: 13px 12px; border-bottom: 1.5px dotted var(--line); vertical-align: middle; font-size: 16px; line-height: 1.3; }
  .cmp thead th { font-family: var(--font-head); font-weight: 500; font-size: 20px; line-height: 1.15; vertical-align: bottom; border-bottom: 2px solid var(--bd); padding-top: 18px; }
  .cmp tbody th { text-align: left; width: 28%; font-weight: var(--fw-bold); }
  .cmp tbody th small { display: block; margin-top: 2px; font-family: var(--font-note); font-weight: 400; font-size: 15px; color: var(--muted); }
  .cmp tbody tr:last-child th, .cmp tbody tr:last-child td { border-bottom: 0; }
  .cmp .us { background: var(--butter-s); border-left: 2px solid var(--ink); border-right: 2px solid var(--ink); font-weight: var(--fw-bold); }
  .cmp thead .us { border-top: 2px solid var(--ink); border-radius: 14px 14px 0 0; }
  .cmp tbody tr:last-child td.us { border-bottom: 2px solid var(--ink); border-radius: 0 0 14px 14px; }
  .cmp td svg { width: 26px; height: 26px; margin-inline: auto; }
  .cmp .no { color: var(--muted); font-weight: var(--fw-regular); }
  .cmp .tx { font-size: 15px; color: var(--muted); font-weight: var(--fw-regular); }
  .cmp .us .tx { color: var(--ink); font-weight: var(--fw-bold); }
  .cmp .soon { display: inline-block; padding: 2px 11px; border-radius: 999px; border: 1.5px dashed var(--accent-text); color: var(--accent-text); font-family: var(--font-note); font-weight: 600; font-size: 16px; transform: rotate(-2deg); }
  .cmp .soon + small { display: block; margin-top: 4px; font-family: var(--font-note); font-weight: 400; font-size: 14px; color: var(--muted); }
  .cmp-note { margin: 22px 8px 0; text-align: center; font-size: 17px; }
  .cmp-hint { display: none; margin: 12px 8px 0; text-align: center; font-size: 16px; }
  @media (max-width: 860px) {
    .cmp { min-width: 700px; }
    .cmp tbody th { width: 150px; min-width: 150px; position: sticky; left: 0; z-index: 1; background: var(--card) var(--grain); font-size: 15px; box-shadow: 8px 0 8px -8px color-mix(in srgb, var(--bd) 50%, transparent); }
    .cmp tbody th small { display: none; }
    .cmp-hint { display: block; }
  }
</style>

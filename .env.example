# Copy this file to `.env` and replace both values with real secrets:
#
#   cp .env.example .env
#   chmod 600 .env
#
# `.env` is git-ignored (see .gitignore) and is read by Compose for the
# production stack: docker compose -f docker-compose.tunnel.yml up -d --build
# Never commit real values.

# Shared password for the browser UI. Use a long random value, for example:
#   openssl rand -base64 32
# The same password is used by everyone in the household (there are no accounts).
# Rotating it invalidates existing browser sessions.
# If the value contains `$`, wrap it in single quotes in .env so Compose does
# not treat it as interpolation: PANTRYPAL_PASSWORD='pa$$word'
PANTRYPAL_PASSWORD=replace-with-a-long-random-password

# Connector token for a dashboard-managed Cloudflare Tunnel.
# Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> your tunnel ->
# Configure -> Install connector. The token is a secret; treat it like a password.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Copy this file to `.env` and replace the value with a real secret:
#
#   cp .env.example .env
#   chmod 600 .env
#
# `.env` is git-ignored (see .gitignore) and is read by Compose for the
# production stack: docker compose -f docker-compose.tunnel.yml up -d --build
# Never commit real values.

# Connector token for a dashboard-managed Cloudflare Tunnel.
# Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> your tunnel ->
# Configure -> Install connector. The token is a secret; treat it like a password.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Signup for new accounts. `open` (the default) lets anyone who reaches the app
# create an account and household. Set `closed` after you create your accounts
# on a public instance.
# PANTRYPAL_SIGNUP=closed

# Email address for help. When set, Settings shows a "Contact support" button.
# PANTRYPAL_SUPPORT_EMAIL=support@rakumi.app

# ---------------------------------------------------------------------------
# Hosted version (email, billing). All off by default: a self-hosted instance
# needs none of this. For local sandbox testing use `.env.sandbox` (git-ignored)
# and `pnpm dev:hosted`.
# ---------------------------------------------------------------------------

# Public base URL, no trailing slash. Required when email or billing is on.
# PANTRYPAL_PUBLIC_URL=https://app.rakumi.app

# Email is on when the SMTP host is set. Resend: host smtp.resend.com,
# user resend, password = your Resend API key.
# PANTRYPAL_SMTP_HOST=smtp.resend.com
# PANTRYPAL_SMTP_PORT=465
# PANTRYPAL_SMTP_USER=resend
# PANTRYPAL_SMTP_PASSWORD=replace-with-smtp-password
# PANTRYPAL_SMTP_FROM=Rakumi <hello@rakumi.app>

# Billing: `off` (default) or `polar`. `polar` needs email on, the public URL
# and all POLAR_* settings below; the server stops at start-up if one is missing.
# PANTRYPAL_BILLING=polar
# POLAR_SERVER=production            # or: sandbox
# POLAR_ACCESS_TOKEN=replace-with-polar-organization-access-token
# POLAR_WEBHOOK_SECRET=replace-with-polar-webhook-secret
# POLAR_PRODUCT_MONTHLY=replace-with-polar-product-id
# POLAR_PRODUCT_YEARLY=replace-with-polar-product-id

# ---------------------------------------------------------------------------
# Off-site backups with Litestream to Cloudflare R2 (tunnel stack only).
# Off by default. Setup: docs/host/backups.md#off-site-backups-with-litestream
# ---------------------------------------------------------------------------
# COMPOSE_PROFILES=backup
# LITESTREAM_BUCKET=rakumi-backups
# LITESTREAM_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# LITESTREAM_ACCESS_KEY_ID=replace-with-r2-access-key-id
# LITESTREAM_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
